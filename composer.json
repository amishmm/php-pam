{
  "name": "amishmm/pam",
  "description": "PAM (Pluggable Authentication Modules) integration for PHP",
  "type": "php-ext",
  "keywords": ["pam", "authentication", "extension", "pecl"],
  "license": "PHP-3.01",
  "version": "3.0.0",
  "authors": [
    {
      "name": "Amish M",
      "email": "anonamish@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "lib-pam": "*"
  },
  "require-dev": {},
  "php-ext": {
    "extension-name": "pam",
    "configure-options": [
      {
        "name": "with-pam",
        "description": "Path to libpam install prefix",
        "needs-value": true
      }
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.0.x-dev"
    }
  }
}
